#!/usr/bin/env zsh

# Compact Git state for tmux. Tmux runs this asynchronously, so repository
# size or filesystem latency never blocks terminal input.
emulate -L zsh

local target=$1 line head='' oid='' ahead=0 behind=0 stash=0
local -i staged=0 modified=0 untracked=0 conflicted=0

[[ -n $target ]] || exit 0
builtin cd -q -- "$target" 2>/dev/null || exit 0

while IFS= read -r line; do
    case $line in
        '# branch.head '*) head=${line#\# branch.head } ;;
        '# branch.oid '*)  oid=${line#\# branch.oid } ;;
        '# branch.ab +'*)
            ahead=${${line#\# branch.ab +}%% *}
            behind=${line##* -}
            ;;
        '# stash '*) stash=${line#\# stash } ;;
        '1 '*|'2 '*)
            local xy=${line[3,4]}
            [[ ${xy[1]} != '.' ]] && (( staged++ ))
            [[ ${xy[2]} != '.' ]] && (( modified++ ))
            ;;
        'u '*) (( conflicted++ )) ;;
        '? '*) (( untracked++ )) ;;
    esac
done < <(command git status --porcelain=v2 --branch --show-stash 2>/dev/null)

[[ -n $head ]] || exit 0
[[ $head == '(detached)' ]] && head="@${oid[1,7]}"
# The helper output is interpreted as a tmux format. Escape a literal # in an
# unusual branch name so it cannot begin a tmux format sequence.
head=${head//\#/##}

local -i has_state=$(( ahead || behind || staged || modified || untracked || conflicted || stash ))

# Powerlevel10k-style branch capsule. State counts occupy a second, darker
# segment only when there is something useful to report.
print -nr -- "#[fg=#78a99f,bg=#161b22]#[fg=#161b22,bg=#78a99f,bold]  $head "

if (( has_state )); then
    print -nr -- "#[fg=#78a99f,bg=#22272e,nobold]"
    (( ahead ))      && print -nr -- " #[fg=#80a8d8,bg=#22272e]⇡$ahead"
    (( behind ))     && print -nr -- " #[fg=#80a8d8,bg=#22272e]⇣$behind"
    (( staged ))     && print -nr -- " #[fg=#87b886,bg=#22272e]+$staged"
    (( modified ))   && print -nr -- " #[fg=#d6ae68,bg=#22272e]~$modified"
    (( untracked ))  && print -nr -- " #[fg=#8b949e,bg=#22272e]?$untracked"
    (( conflicted )) && print -nr -- " #[fg=#d4777f,bg=#22272e]!$conflicted"
    (( stash ))      && print -nr -- " #[fg=#78a99f,bg=#22272e]≡$stash"
    print -nr -- " #[fg=#22272e,bg=#161b22]"
else
    print -nr -- "#[fg=#78a99f,bg=#161b22,nobold]"
fi
